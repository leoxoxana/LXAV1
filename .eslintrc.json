{
  "root": true,
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": 2021,
    "sourceType": "script"
  },
  "env": {
    "es2021": true
  },
  "rules": {
    "no-unused-vars": ["warn", { "args": "none", "varsIgnorePattern": "^_" }],
    "no-empty": ["error", { "allowEmptyCatch": true }],
    "no-constant-condition": ["error", { "checkLoops": false }]
  },
  "overrides": [
    {
      "files": ["functions/**/*.js", "api/**/*.js", "local-server.js","scripts/**/*.js", "deployment-check.js", "audit-simulations.js", "jest.setup.js"],
      "env": { "node": true, "es2021": true }
    },
    {
      "files": ["middleware.js"],
      "parserOptions": { "sourceType": "module" },
      "env": { "node": true, "es2021": true }
    },
    {
      "files": ["*.test.js"],
      "env": { "node": true, "jest": true, "es2021": true }
    },
    {
      "files": ["game-engine.js"],
      "env": { "node": true, "browser": true, "es2021": true }
    },
    {
      "files": ["renderer.js"],
      "env": { "browser": true, "es2021": true },
      "globals": {
        "LxaGameEngine": "readonly",
    "LXAAdminRadio": "readonly",
        "lxaSaveState": "writable"
      },
      "rules": {
        "no-func-assign": "off"
      }
    },
    {
      "files": ["spin-button.js"],
      "env": { "browser": true, "es2021": true }
    },
    {
      "files": ["header-fit.js", "boot-wild-preload.js", "sw-register.js", "radio.js", "admin-radio.js"],
      "env": { "browser": true, "es2021": true },
      "globals": { "LXASpinButton": "readonly", "lang": "readonly", "lxaRequest": "readonly", "lxaAccount": "readonly", "lxaToken": "readonly", "renderAccountPanel": "readonly", "lxaRadioCache": "writable", "lxaConfirm": "readonly" }
    },
    {
      "files": ["sw.js"],
      "env": { "serviceworker": true, "browser": true, "es2021": true }
    }
  ]
}
